google-services.json

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# Log files
*.log

# Captures (Android Studio profiling)
/captures/

# Signing config
signing.properties

# Release outputs (APK/AAB should not be in repo)
app/release/
app/build/outputs/

# Crashlytics
crashlytics-build.properties

# Firebase
firebase-debug.log

# Kotlin
.kotlin/

