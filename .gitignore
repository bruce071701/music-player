.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/dictionaries
.idea/libraries
.idea/assetWizardSettings.xml
.idea/navEditor.xml

# Keystore files
*.jks
*.keystore

# External native build folder
.externalNativeBuild/
.cxx/

