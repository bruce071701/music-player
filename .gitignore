*.apk
*.aab
*.ap_
*.dex

# Files for the ART/Dalvik VM
*.odex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/
**/build/

# Local configuration file (sdk path, etc)
local.properties

